<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    B+ 平台外壳共用清单。

    平台能力（可执行文件路径 / 编码转换）的接口在 header/platform/Platform.h，
    共享编译单元 UNOOL.Core 只调用不实现；具体平台的实现由本清单登记，
    在 3 个 exe 工程（Server / Client / Tests）中各编译一次，由链接器解析 Core.lib 中的未定义符号。

    换平台时只需提供 source/platform/<平台>/ 下的另一份实现，
    并让对应外壳工程导入替换后的清单；Core 与规则内核无需重编译。
    路径用 MSBuildThisFileDirectory 定位，避免依赖 SolutionDir /
    工程文件所在目录，也不受各工程 PCH 名称不同的影响。
  -->
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\source\platform\WindowsPlatform.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <!--
    运行库复制。3 个 exe 都链接 SFML 的导入库，进程启动时必须能在输出目录
    找到对应的 sfml-*.dll；缺了会直接 0xc0000135 起不来（CI 的「运行单测」
    就是踩在这里：干净克隆的 x64\Release 里只有 exe，没有 dll）。
    Debug / Release 各取 dep\SFML\bin 下的同名子目录，与 *-d.lib / *.lib 对应，
    路径用 MSBuildThisFileDirectory 定位，不受工程目录深度影响。
  -->
  <Target Name="CopySfmlRuntime" AfterTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)..\dep\SFML\bin\$(Configuration)')">
    <ItemGroup>
      <SfmlRuntimeDll Include="$(MSBuildThisFileDirectory)..\dep\SFML\bin\$(Configuration)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SfmlRuntimeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
